# Copy to .env (git-ignored). Secrets and machine-specific settings only:
# budgets, step limits and timeouts belong in versioned config files so every
# reported number is reproducible from the repo.

# All model calls (base model, expensive baseline, any harness-internal calls)
# go through OpenRouter so dollar costs come from one price table.
# Use a dedicated key with a hard credit limit set in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# Only for the LLM-judged verifier of dev task 009-repair-org-chart-layout
# (Gemini judge, default model gemini-3-flash-preview). Without it that task's
# judge check errors and its maximum reward is 0.75. Not used by any eval task.
GEMINI_API_KEY=

# Task images are built for amd64 on every machine (several TUA-Bench images
# are amd64-only). Leave as is unless you know every selected task builds natively.
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Concurrent Harbor trials. Keep 1 unless Docker has >= 8 GB per concurrent trial.
N_CONCURRENT=1
